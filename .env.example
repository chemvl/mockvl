# Copy to .env and fill in real values. Every variable here is validated
# at boot by apps/api/src/config/env.ts — missing/invalid values crash startup.

NODE_ENV=development
PORT=3000
# Compose Postgres maps to host port 5433 (5432 often taken by a local install)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/app
# Optional streaming read replica: SELECTs route here, writes stay on
# DATABASE_URL (auth reads are pinned to the primary — see app.defaults.ts).
# Unset = everything on DATABASE_URL. Never run migrations against a replica.
# Example: postgres://user:pass@replica-host:5432/app
#DATABASE_REPLICA_URL=
# Connections per pool per process (primary and replica each get this many).
DATABASE_POOL_MAX=10
REDIS_URL=redis://localhost:6380
CACHE_DEFAULT_TTL_S=300
RATE_LIMIT_FAIL_OPEN=true

# App-user JWT auth (Phase 3). Secrets must be at least 32 characters.
# Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Admin Google OIDC (Phase 9)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# FCM push notifications — all-or-none: set all three (Firebase service
# account) or none; omitted = log-only sender, no Firebase project needed.
FCM_PROJECT_ID=my-firebase-project
FCM_CLIENT_EMAIL=firebase-adminsdk-xxxxx@my-project.iam.gserviceaccount.com
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Google Workspace domain admins must belong to, e.g. company.com
GOOGLE_ALLOWED_HD=
# Optional: first admin owner (an empty value fails email validation — keep it commented out)
#ADMIN_SEED_OWNER_EMAIL=owner@example.com

# Admin sessions (Phase 9). Must be at least 32 characters.
ADMIN_SESSION_SECRET=
ADMIN_URL=http://localhost:8000
API_URL=http://localhost:3000/api
# Public app origin (REQUIRED) — the Mockvl SPA; mock URLs default to
# ${APP_URL}/m. Neither ADMIN_URL (dashboard) nor API_URL (this API) is the app.
APP_URL=http://localhost:5173
API_BASE_PATH=/api

RATE_LIMIT_GLOBAL_LIMIT=100
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
RATE_LIMIT_AUTH_LIMIT=10
RATE_LIMIT_AUTH_WINDOW_MS=60000
TRUST_PROXY=false

# Email delivery provider (welcome email): resend | smtp | log-only.
# Unset = auto-detect (Resend when its pair is set, otherwise workers run
# log-only). Set explicitly when more than one provider is configured.
#EMAIL_PROVIDER=
# Resend — all-or-none: set both or neither.
#RESEND_API_KEY=
#RESEND_FROM_ADDRESS=noreply@yourdomain.com
# Generic SMTP (EMAIL_PROVIDER=smtp). Plaintext only (no TLS/STARTTLS).
# SMTP_HOST and SMTP_FROM_ADDRESS are required; auth is optional —
# set BOTH username and password or neither.
#SMTP_HOST=smtp.example.com
#SMTP_PORT=25
#SMTP_USERNAME=
#SMTP_PASSWORD=
#SMTP_FROM_ADDRESS=noreply@yourdomain.com

DOCS_ENABLED=true
LOG_LEVEL=info

# Mockvl — hosted Prism mock servers
# Public base of mock URLs; unset = ${APP_URL}/m
#MOCK_PUBLIC_BASE_URL=http://localhost:5173/m
# Optional: only verified Google Workspace accounts of this domain may sign in
# to the app and use workspaces. Unset = any Google account.
#APP_GOOGLE_ALLOWED_HD=example.com
# Requests per minute per (client IP, mock) on /m/*
MOCK_RATE_LIMIT_PER_MINUTE=600
# Parsed-schema LRU size (entries = mock versions) per process
MOCK_OPS_CACHE_SIZE=200
