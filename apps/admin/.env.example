# Copy to .env and fill in real values. Read by vite.config.ts.

# Vite env label used by vite.config.ts dev-proxy logic (dev|test|pre)
VITE_ENV=dev

# Dev-server base (mode=development only)
VITE_BASE_URL=/

# localStorage namespace (src/lib/storage.ts).
VITE_APP_PROJECT_NAME=mockvl-admin

# Production asset base (must end with /).
VITE_BASE_URL_PUBLIC=/admin/

# Router path prefix for deployed builds (admin served under /admin). Dev ignores this ('/').
VITE_ROUTER_BASENAME=/admin
VITE_ADMIN_API_URL=/api

# API origin — dev proxy target. The generated client calls relative /api URLs
# (same-origin in deployment).
VITE_APP_API_ENDPOINT=http://localhost:3000
